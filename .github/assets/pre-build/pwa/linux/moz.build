if CONFIG["MOZ_WIDGET_TOOLKIT"] == "gtk":
    EXPORTS.mozilla += [
        "FloorpLinuxTaskbar.h",
    ]

    UNIFIED_SOURCES += [
        "FloorpLinuxTaskbar.cpp",
    ]

    XPIDL_SOURCES += [
        "nsIFloorpLinuxTaskbar.idl",
    ]

    XPIDL_MODULE = "floorpLinuxTaskbar"

    LOCAL_INCLUDES += [
        "!/ipc/ipdl/_ipdlheaders",
        "/dom/base",
        "/ipc/chromium/src",
        "/widget",
        "/widget/gtk",
    ]

    CXXFLAGS += CONFIG["MOZ_GTK3_CFLAGS"]

    FINAL_LIBRARY = "xul"

