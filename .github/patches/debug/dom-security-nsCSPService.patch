 #include "mozilla/Preferences.h"
 #include "mozilla/StaticPrefs_security.h"
@@ -147,6 +148,16 @@ static bool SubjectToCSP(nsILoadInfo* aLoadInfo, nsIURI* aURI,
   // default decision, CSP can revise it if there's a policy to enforce
   *aDecision = nsIContentPolicy::ACCEPT;
 
+  // Allow HTTP(S) loads in debug builds with MOZ_ALLOW_PRIVILEGED_REMOTE_LOADS
+  // This bypasses CSP checks for development purposes
+  if (mozilla::EnvHasValue("MOZ_ALLOW_PRIVILEGED_REMOTE_LOADS")) {
+    nsAutoCString scheme;
+    aContentLocation->GetScheme(scheme);
+    if (scheme.EqualsLiteral("http") || scheme.EqualsLiteral("https")) {
+      return NS_OK;
+    }
+  }
+
