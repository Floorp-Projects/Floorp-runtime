# SPDX-License-Identifier: MPL-2.0

ac_add_options --with-app-name=floorp
ac_add_options --with-app-basename=Floorp

# Android Configuration
# Building GeckoView/Firefox for Android
ac_add_options --enable-application=mobile/android

# Target architecture: 32-bit ARM for legacy Android devices
ac_add_options --target=arm-linux-androideabi

# Build GeckoView Example application for testing
ac_add_options --enable-android-subproject=geckoview_example

# Disable features not needed for Android
ac_add_options --disable-crashreporter
ac_add_options --enable-bootstrap

# Telemetry
ac_add_options MOZ_TELEMETRY_REPORTING=

mk_add_options AUTOCLOBBER=1
