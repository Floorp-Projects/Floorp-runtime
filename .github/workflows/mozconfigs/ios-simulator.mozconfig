# iOS GeckoView Build Configuration

# Enable the iOS application target
ac_add_options --enable-application=mobile/ios

# Target iOS Simulator (arm64 for Apple Silicon Mac)
ac_add_options --target=aarch64-apple-ios-sim

# App naming - must match GeckoTestBrowser project expectations
ac_add_options --with-app-name=geckotest
ac_add_options --with-app-basename=GeckoTest

# Build options
ac_add_options --disable-tests
ac_add_options --disable-crashreporter
ac_add_options --enable-bootstrap
ac_add_options --enable-rust-simd

# Disable telemetry
MOZ_TELEMETRY_REPORTING=

# Debug build for testing
ac_add_options --enable-debug

# Add SubFrameworks search path for Xcode 26+ SDK compatibility
# UIUtilities framework moved to SubFrameworks in iOS 26 SDK
# We need to detect the SDK path dynamically since Xcode version varies

# The SDK path will be determined by the build system, but we need to ensure
# the SubFrameworks path is included. Use xcrun to get the correct SDK path.
IPHONE_SDK_PATH="$(xcrun --sdk iphonesimulator --show-sdk-path 2>/dev/null || echo '')"
if [ -n "$IPHONE_SDK_PATH" ]; then
    SUBFRAMEWORKS_PATH="$IPHONE_SDK_PATH/System/Library/SubFrameworks"
    UIUTILITIES_PATH="$IPHONE_SDK_PATH/System/Library/SubFrameworks/UIUtilities.framework/Headers"
    export CFLAGS="-iframework $SUBFRAMEWORKS_PATH -I$UIUTILITIES_PATH"
    export CXXFLAGS="-iframework $SUBFRAMEWORKS_PATH -I$UIUTILITIES_PATH"
    export OBJCFLAGS="-iframework $SUBFRAMEWORKS_PATH -I$UIUTILITIES_PATH"
fi

