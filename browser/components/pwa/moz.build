with Files("**"):
    BUG_COMPONENT = ("Firefox", "General")

XPCOM_MANIFESTS += [
    "components.conf",
]

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "cocoa":
    EXPORTS.mozilla += [
        "mac/nsMacSSBSupport.h",
    ]

    XPIDL_SOURCES += [
        "mac/nsIMacSSBSupport.idl",
    ]

    XPIDL_MODULE = "widget_cocoa"

    SOURCES += [
        "mac/nsMacSSBSupport.mm",
    ]

    FINAL_LIBRARY = "xul"

    LOCAL_INCLUDES += [
        "/widget/cocoa",
    ]

    include("/ipc/chromium/chromium-config.mozbuild")

    OS_LIBS += [
        "-framework Cocoa",
        "-framework CoreServices",
        "-framework ImageIO",
    ]

    DIRS += [
        "appshim",
    ]
